# Local API only. The API routes are mounted at the root.
DMONEY_BASE_URL=http://127.0.0.1:5000
DMONEY_PARTNER_KEY=
DMONEY_DEFAULT_OTP=0000

# Set these to the dedicated, active test accounts. Each identity authenticates separately.
AGENT1_IDENTIFIER=
AGENT1_PASSWORD=
AGENT2_IDENTIFIER=
AGENT2_PASSWORD=
CUSTOMER1_IDENTIFIER=
CUSTOMER1_PASSWORD=
CUSTOMER2_IDENTIFIER=
CUSTOMER2_PASSWORD=
MERCHANT1_IDENTIFIER=
MERCHANT1_PASSWORD=
MERCHANT2_IDENTIFIER=
MERCHANT2_PASSWORD=

# Transaction values are in Tk. Keep low enough for the dedicated accounts' balances/limits.
DMONEY_DEPOSIT_AMOUNT=10
DMONEY_SEND_AMOUNT=10
DMONEY_PAYMENT_AMOUNT=10

# One VU per independent flow by default; customize cautiously for a local application.
DMONEY_VUS_PER_FLOW=1
DMONEY_REQUEST_TIMEOUT=10s


